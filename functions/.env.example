# Non-secret switches only. Copy to functions/.env.<development-project-id>.
# Set true only after VNPay Sandbox secrets, registered IPN and Return URL are configured.
VNPAY_ENABLED=false
VNPAY_IPN_URL=https://example.invalid/vnpayIpn
VNPAY_RETURN_URL=https://example.invalid/vnpayReturn
VNPAY_ORDER_TYPE=other
# QUERYDR stays disabled until its request/response format is verified with Sandbox.
VNPAY_QUERY_ENABLED=false
VNPAY_SERVER_IP=
